{
  "name": "poker-hands-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "自分のハンド履歴を Claude から読むための個人用 MCP サーバー（stdio）",
  "type": "module",
  "bin": {
    "poker-hands-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
